[Unit]
Description=TravelMemory Node.js Express backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/travelmemory/backend
Environment=NODE_ENV=production
EnvironmentFile=/opt/travelmemory/backend/.env
ExecStart=/usr/bin/node /opt/travelmemory/backend/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/travelmemory/backend

[Install]
WantedBy=multi-user.target
